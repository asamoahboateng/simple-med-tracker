# Virtual environment
.venv/

# PyInstaller output
build/
dist/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Databases (real data lives in the user data folder, but never commit any)
*.db
*.db-wal
*.db-shm

# Editors / OS
.DS_Store
.vscode/
.idea/

# Local secrets (MinIO keys) - never commit
.env

# MinIO keys generated at build time from .env / GitHub secrets - never commit
cloud_keys.py

# Sync server settings (holds the database password)
server/.env
