# Copy to server/.env and set a long random password (e.g. from: openssl rand -hex 24).
POSTGRES_PASSWORD=change-me-two
# Port on 127.0.0.1 that your HTTPS proxy forwards sync.kalourmade.com to.
SYNC_PORT=8800

# Password for the /status page (sign in with any username). Leave empty to turn the page off.
STATUS_PASSWORD=
