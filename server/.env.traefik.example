# For docker-compose-traefik.yml. Copy to server/.env and fill in.
# Password for the sync server's own database login (e.g. from: openssl rand -hex 24).
POSTGRES_PASSWORD=change-me

# Existing Postgres on the km_traefik-public network, and a login allowed to create roles and databases
# (only used once, by db_init).
PG_HOST=postgres
PG_PORT=5432
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=change-me

# Optional: names for the sync server's database and login.
SYNC_DB=medtracker_sync
SYNC_DB_USER=medtracker

# Hostname Traefik routes to the API.
SYNC_DOMAIN=sync.kalourmade.com

# Password for the /status page (sign in with any username). Leave empty to turn the page off.
STATUS_PASSWORD=

# Key for creating companies over HTTPS (PUT /v1/admin/<app>/<company>), e.g. from:
# openssl rand -hex 32. Leave empty to allow it only with the admin command on the server.
ADMIN_KEY=
